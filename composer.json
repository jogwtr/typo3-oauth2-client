{
    "name": "co-stack/typo3-oauth2-client-nuevo",
    "description": "TYPO3 OAuth2 Login Client (backend and frontend)",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-only",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "psr/log": "*",
        "league/oauth2-client": "^2.8.1",
        "typo3/cms-core": "^13.4",
        "friendsoftypo3/fontawesome-provider": "^v1.0.5"
    },
    "autoload": {
        "psr-4": {
            "CoStack\\Oauth2Client\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "oauth2_client_nuevo"
        }
    }
}
